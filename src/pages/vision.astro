---
import Base from '../layouts/Base.astro';

const items = [
  { title: 'Intuitive Interaction', text: 'We aim to redefine how people interact with technology by making digital tools more intuitive, spatial, and responsive. No more clunky menus or flat interfaces—just fluid, instinctive control that aligns with how we think and move.' },
  { title: 'Seamless Integration with Real-World Tasks', text: 'Our goal is to bridge the gap between the digital and the physical. Whether you\'re managing projects, analyzing data, or collaborating across time zones, Somnex integrates these workflows into a single, immersive space designed to reflect the complexity and pace of real-world work.' },
  { title: 'Computing, Reimagined', text: 'We believe the future of computing is centralized—not across dozens of devices, but in a single, powerful headset. Somnex is designed to become your primary computing hub, combining performance, portability, and immersive flexibility in one compact system.' },
  { title: 'Distributed Performance', text: 'We believe the future of computing is decentralized from devices and powered by remote processing. Instead of relying on dozens of local machines, Somnex taps into cloud and edge computing to deliver performance, flexibility, and immersive capability anywhere. The headset becomes a lightweight access point—a portal to powerful, scalable computing resources that move with you.' },
];
---

<Base title="Vision" description="A future where digital tools are a natural extension of work.">
  <div class="page">
    <header class="page-header reveal"><h1>Vision</h1></header>

    <section class="panel reveal">
      <h2>Our Vision</h2>
      <p>At Somnex, we envision a future where digital tools are less of a layer added over work—and more of a natural extension of it.</p>
    </section>

    <div class="about-tree">
      {items.map((p, i) => (
        <div class={`about-tree-item reveal ${i % 2 ? 'right' : 'left'}`}>
          <div class="card about-tree-card">
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</Base>
