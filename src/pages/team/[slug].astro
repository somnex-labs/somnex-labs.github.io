---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { teams } from '../../data/site';

export async function getStaticPaths() {
  const people = await getCollection('team', (p) => p.data.hasProfile);
  return people.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { name, role, team, focus, currentWork } = entry.data;
const { Content } = await render(entry);
const tabColor = teams.find((t) => t.name === team)?.color;
---

<Base title={name} description={`${name} — ${role} at Somnex.`}>
  <div class="page narrow">
    <section class="panel reveal" data-label="Profile">
      <div class="profile-head">
        <div class="member-image" aria-hidden="true" />
        <div>
          <p class="eyebrow" style={tabColor ? `--tab:${tabColor}` : undefined}>{team} Team</p>
          <h1 style="font-size:clamp(2rem,6vw,3rem);font-weight:300">{name}</h1>
          <p class="role">{role}</p>
        </div>
      </div>
      <Content />
      {(focus || currentWork) && (
        <div class="profile-meta">
          {focus && <div><strong>Focus</strong><p>{focus}</p></div>}
          {currentWork && <div><strong>Current work</strong><p>{currentWork}</p></div>}
        </div>
      )}
    </section>
    <a class="back-link" href="/our-team">← Back to Our Team</a>
  </div>
</Base>
