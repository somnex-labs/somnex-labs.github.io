---
import Base from '../layouts/Base.astro';
---

<Base title="Contact" description="Get in touch with the Somnex team.">
  <div class="page">
    <header class="page-header reveal"><h1>Contact</h1></header>

    <section class="panel reveal" data-label="Transmit // Message">
      <div class="form-wrap"><iframe
        class="form-frame"
        src="https://docs.google.com/forms/d/e/1FAIpQLSfNkTiZ5IVh-nOkhWuc-Umziam1v7t0wO0-k4fDjzpqOa2JzA/viewform?embedded=true"
        title="Somnex Contact Form"
        loading="lazy"
      >Loading…</iframe></div>

      <div class="contact-info">
        <h3>Other Ways to Reach Us</h3>
        <div class="contact-links">
          <a href="mailto:contact@somnex.com">contact@somnex.com</a>
          <a href="#">Twitter</a>
          <a href="#">LinkedIn</a>
        </div>
      </div>
    </section>
  </div>
</Base>
