---
import Base from '../layouts/Base.astro';

interface Props {
  title: string;
  blurb: string;
  panels: { title: string; text: string }[];
}
const { title, blurb, panels } = Astro.props;
---

<Base title={title} description={blurb}>
  <div class="page">
    <header class="page-header reveal">
      <p class="eyebrow">Coming soon</p>
      <h1>{title}</h1>
      <p>{blurb}</p>
    </header>
    <div class="grid">
      {panels.map((p, i) => (
        <section class="panel reveal" style={`--d:${i * 80}ms`}>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </section>
      ))}
    </div>
    <a class="cta reveal" href="/">Return to the homepage</a>
  </div>
</Base>
