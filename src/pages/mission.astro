---
import Base from '../layouts/Base.astro';

const points = [
  { title: 'Build for real work', text: 'Design a next generation XR headset for hands-on and advanced engineering design applications, with a digital environment that connects naturally to real-world workflows.' },
  { title: 'Bring teams together', text: 'Increase intrateam collaboration and support sustained focus by replacing fragmented multitasking with a single, unified workspace.' },
  { title: 'Integrate everything', text: 'Combine hardware, software, and connectivity so deep work, communication, intuitive visualization, and task management live in one place for professionals.' },
];
---

<Base title="Mission" description="Somnex exists to change how people use digital tools for hands-on engineering work.">
  <div class="page">
    <header class="page-header reveal">
      <p class="eyebrow">Why we exist</p>
      <h1>Mission</h1>
    </header>

    <section class="panel reveal" data-label="01 // Statement">
      <h2>Our Mission</h2>
      <p>Somnex exists to change how people use digital tools — moving away from fragmented multitasking and toward a unified workspace built for hands-on, advanced engineering design.</p>
    </section>

    <div class="grid">
      {points.map((p, i) => (
        <section class="panel reveal" data-label={`0${i + 2} // Focus`} style={`--d:${i * 80}ms`}>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </section>
      ))}
    </div>

    <div class="reveal" style="display:flex;gap:1rem;flex-wrap:wrap">
      <a class="cta" href="/vision">Read our vision</a>
      <a class="cta" href="/join-the-team">Join the team</a>
    </div>
  </div>
</Base>
