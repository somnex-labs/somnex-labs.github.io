---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, date, tags, excerpt, eyebrow, intro, image, imageAlt } = entry.data;
const { Content } = await render(entry);
// Unsplash serves arbitrary widths; don't ship 1200px for a 320px frame.
const src = image?.includes('images.unsplash.com') ? image.replace(/w=\d+/, 'w=720') : image;
---

<Base title={title} description={excerpt}>
  <div class="page">
    <a class="back-link" href="/blog">← Back to blog</a>
    <header class="panel article-hero reveal">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p>{intro ?? excerpt}</p>
      <div class="tag-list">{tags.map((t) => <span class="tag">{t}</span>)}</div>
    </header>
    <article class="panel article-body reveal">
      {src && <div class="article-image"><img src={src} alt={imageAlt} width="720" height="540" decoding="async" /></div>}
      <Content />
    </article>
  </div>
</Base>
