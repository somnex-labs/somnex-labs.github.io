---
import Base from '../layouts/Base.astro';

const points = [
  { title: 'Learn by doing', text: 'Give people hands-on practice with machines in an immersive digital environment that connects naturally to real-world workflows.' },
  { title: 'Train with confidence', text: 'Build skills and sustained focus through realistic, repeatable practice, so people are better prepared before they work with the real thing.' },
  { title: 'Bring it together', text: 'Combine hardware, software, and connectivity so trainers and trainees can learn, communicate, and practice in one place.' },
];
---

<Base title="Mission" description="Somnex exists to help people learn to work with machines through immersive, hands-on training.">
  <div class="page">
    <header class="page-header reveal">
      <p class="eyebrow">Why we exist</p>
      <h1>Mission</h1>
    </header>

    <section class="panel reveal" data-label="01 // Statement">
      <h2>Our Mission</h2>
      <p>Somnex exists to help people learn to work with machines — replacing passive instruction with immersive, hands-on training that builds real skills.</p>
    </section>

    <div class="grid">
      {points.map((p, i) => (
        <section class="panel reveal" data-label={`0${i + 2} // Focus`} style={`--d:${i * 80}ms`}>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </section>
      ))}
    </div>

    <div class="reveal" style="display:flex;gap:1rem;flex-wrap:wrap">
      <a class="cta" href="/vision">Read our vision</a>
      <a class="cta" href="/join-the-team">Join the team</a>
    </div>
  </div>
</Base>
